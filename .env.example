COMPANY_NAME="Vercel Inc."
SITE_NAME="Next.js Commerce"
SHOPIFY_REVALIDATION_SECRET=""
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""
SHOPIFY_STORE_DOMAIN="[your-shopify-store-subdomain].myshopify.com"
# Host that serves the hosted checkout. Leave unset to use SHOPIFY_STORE_DOMAIN.
# Set it to a branded subdomain (checkout.whiskcam.com) once that domain is
# connected AND set as the primary domain in Shopify — otherwise the buyer keeps
# crossing to *.myshopify.com at the payment step, which breaks the GA4 session
# and swaps the brand out of the address bar mid-purchase.
SHOPIFY_CHECKOUT_DOMAIN=""
